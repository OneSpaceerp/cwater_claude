# =============================================================================
#  C-Water — environment
# =============================================================================
#  Copy to `.env.local` for local development. On Vercel, set these in
#  Settings → Environment Variables instead; nothing here belongs in the repo.
#
#  The cPanel static export does NOT read this file at runtime — it has no
#  runtime. Its equivalents are baked in at build time from deploy.targets.json,
#  and its mail settings live in the CONFIGURATION block of public/api/leads.php.
# =============================================================================

# -----------------------------------------------------------------------------
#  Site identity — baked into canonical tags, hreflang, Open Graph and sitemap
# -----------------------------------------------------------------------------
# The exact origin visitors use, no trailing slash. Wrong here means search
# engines indexing URLs that do not exist.
NEXT_PUBLIC_SITE_URL=https://cw-eg.com

# Subdirectory prefix, e.g. /cwaterv2. Empty at a domain root. A build made for
# one prefix cannot be served from another.
NEXT_PUBLIC_BASE_PATH=

# 1 keeps the deployment out of every search index. Set it on any address that
# is not the one the brand should be found at — a *.vercel.app copy of the whole
# site would otherwise compete with the real domain.
SITE_NOINDEX=

# -----------------------------------------------------------------------------
#  Lead delivery — required, or the forms return an error
# -----------------------------------------------------------------------------
#  The forms deliberately fail loudly when this is unset: a success screen over
#  an enquiry that reached nobody is the one outcome worth avoiding.

# API key from resend.com. Never commit a real value.
RESEND_API_KEY=

# The From address. MUST be on a domain verified with the mail provider, or the
# message fails SPF and is filed as spam. The visitor's own address goes into
# Reply-To, so replying from the inbox still reaches them.
LEAD_FROM_EMAIL=website@cw-eg.com

# Quote requests, sales enquiries and general enquiries.
LEAD_TO_COMMERCIAL=info@cw-eg.com

# Solution requests, engineering questions and support requests.
LEAD_TO_TECHNICAL=info@cw-eg.com

# Optional, comma-separated. Copied on every enquiry.
LEAD_CC=

# -----------------------------------------------------------------------------
#  Testing only — leave unset in every deployment
# -----------------------------------------------------------------------------
# Overrides the mail provider endpoint so the composed message can be asserted
# against a local receiver instead of being sent to real inboxes.
RESEND_API_URL=
